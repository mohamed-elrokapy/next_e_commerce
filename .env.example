# Copy to .env.local and fill in. Values below are placeholders, never commit real ones.

# --- Next.js app (.env.local) ---
# Convex deployment URL, shown after `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# CLERK_PUBLISHABLE_KEY format check: pk_test_ followed by base64 of "<frontend-api-host>$".
# This placeholder decodes to "example.clerk.accounts.dev$" so the app builds without a Clerk account.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_replace_me
# Public URL of this app, used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret of the Stripe webhook endpoint pointing to /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me

RESEND_API_KEY=re_replace_me

# --- Convex dashboard environment variables (Settings > Environment Variables) ---
# The Convex functions in convex/ read these, they are NOT read from .env.local.
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL of the "convex" JWT template
# CLERK_WEBHOOK_SECRET      Signing secret of the Clerk webhook (user.created) -> <convex-site-url>/clerk-webhook
# STRIPE_SECRET_KEY         same name as above
# NEXT_PUBLIC_APP_URL       same name as above
# STRIPE_PRICE_ID_MONTHLY   Stripe recurring price id for the monthly Pro plan
# STRIPE_PRICE_ID_YEARLY    Stripe recurring price id for the yearly Pro plan
# UPSTASH_REDIS_REST_URL    Upstash Redis REST URL (checkout rate limiting)
# UPSTASH_REDIS_REST_TOKEN  Upstash Redis REST token
